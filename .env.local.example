# Copy to .env.local and fill in.

# --- Database ---
# Local: one URL is enough, both vars can point at the same instance:
#   docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coach_me"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/coach_me"

# On Supabase + Vercel these must be DIFFERENT connection strings (see
# Project Settings -> Database in the Supabase dashboard):
#   DATABASE_URL — the "Transaction" pooler (port 6543, PgBouncer), used at
#     runtime by serverless functions. Must end in ?pgbouncer=true.
#   DIRECT_URL   — the direct connection (port 5432). Prisma migrations need
#     this — PgBouncer's transaction mode doesn't support the prepared
#     statements `prisma migrate deploy` relies on.
# DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# --- Claude auth ---
# Run `claude setup-token` to generate an OAuth token for your Pro
# subscription (see lib/agentClient.ts). Do NOT also set ANTHROPIC_API_KEY
# here or anywhere in your shell env — it silently overrides the OAuth token.
# For deploying to Vercel: the same token also needs to be set there as
# CLAUDE_CODE_OAUTH_TOKEN (verify the exact var name against your Agent SDK
# version's docs — this is the mechanism `claude setup-token` is designed for,
# used the same way as Claude Code's GitHub Action).
# CLAUDE_CODE_OAUTH_TOKEN=""

# Sent by Vercel Cron automatically as `Authorization: Bearer <value>`.
# For local testing, send the same header yourself when curling /api/cron/*.
CRON_SECRET="dev-cron-secret"

# Required on /api/sync, /api/chat, and /api/workouts as `Authorization: Bearer <value>`.
APP_SECRET="dev-app-secret"

# Same value as APP_SECRET, exposed to the browser so the dashboard (lib/apiClient.ts)
# can attach it. NEXT_PUBLIC_* vars are inlined into the client bundle — fine for a
# solo app on your own machine, not real auth if this is ever deployed publicly.
NEXT_PUBLIC_APP_SECRET="dev-app-secret"

# Not yet used — Strava ingestion is still a stub (see README "Stubbed").
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
